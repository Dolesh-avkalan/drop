+class _LeaseLimiter:
+    """K client leases; each held until response + ``hold`` seconds.
+
+    The D101 gate used exactly this (K=5, 55 ms): a client must not open a new
+    connection while the server is still draining the previous one.  With the
+    raw tight reconnect loop the harness transiently held >6 backend requests
+    and the 7th was (correctly) rejected ``busy`` -- a harness over-subscription,
+    not a product fault.  A ``busy`` here is still an error, never forgiven.
+    """
+
+    def __init__(self, capacity, hold):
+        self._sem = threading.BoundedSemaphore(capacity)
+        self._hold = hold
+        self.max_held = 0
+        self._lock = threading.Lock()
+        self._held = 0
+
+    def acquire(self):
+        self._sem.acquire()
+        with self._lock:
+            self._held += 1
+            if self._held > self.max_held:
+                self.max_held = self._held
+
+    def release(self, response_ts):
+        wait = (response_ts + self._hold) - time.monotonic()
+        if wait > 0:
+            time.sleep(wait)
+        with self._lock:
+            self._held -= 1
+        self._sem.release()
+
+
+def _exc_detail(exc, op):
+    """Rich, countable diagnostics for one failed operation."""
+    return {"op": op, "kind": type(exc).__name__,
+            "code": getattr(exc, "code", None),
+            "message": str(exc)[:160],
+            "outcome_uncertain": getattr(exc, "outcome_uncertain", None),
+            "retry_safe": getattr(exc, "retry_safe", None)}
+
+
